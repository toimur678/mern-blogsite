# Copy to .env and fill in values. Never commit real credentials.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/editorial
# Generate a long random secret; tokens expire after seven days.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated exact frontend origins. Production must use HTTPS.
CLIENT_URL=http://localhost:5173

# Initial studio access without modifying the database. Set strong passwords.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional second staff account.
EDITOR_EMAIL=
EDITOR_PASSWORD=

# Optional: required for file uploads. HTTPS cover URLs work without ImageKit.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional writing assistant accepting {title, subTitle} and returning {blocks}.
AI_MICROSERVICE_URL=
# Set to 1 only behind a trusted reverse proxy.
TRUST_PROXY=0
